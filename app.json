```javascript
let bankData = null;

const accountInput = document.getElementById("account");
const passwordInput = document.getElementById("password");
const showPasswordButton = document.getElementById("showPassword");
const loginButton = document.getElementById("loginButton");
const loginMessage = document.getElementById("loginMessage");


// LOAD ACCOUNT DATA

fetch("data.json")
  .then(response => {
    if (!response.ok) {
      throw new Error("data.json could not be loaded");
    }

    return response.json();
  })
  .then(data => {
    bankData = data;
  })
  .catch(() => {
    loginMessage.textContent =
      "Bank system data could not be loaded.";
  });


// SHOW / HIDE PASSWORD

showPasswordButton.addEventListener("click", function () {

  if (passwordInput.type === "password") {

    passwordInput.type = "text";
    showPasswordButton.textContent = "Hide";

  } else {

    passwordInput.type = "password";
    showPasswordButton.textContent = "Show";

  }

});


// LOGIN

loginButton.addEventListener("click", function () {

  loginMessage.textContent = "";

  if (!bankData) {
    loginMessage.textContent =
      "Please wait for the bank system to load.";

    return;
  }

  const account = accountInput.value.trim();
  const password = passwordInput.value;

  if (!account || !password) {

    loginMessage.textContent =
      "Please enter your account number and password.";

    return;
  }

  const user = bankData.accounts.find(function (item) {

    return (
      item.account === account &&
      item.password === password
    );

  });


  if (!user) {

    loginMessage.textContent =
      "Invalid account number or password.";

    return;
  }


  localStorage.setItem(
    "pibUser",
    JSON.stringify({
      account: user.account,
      name: user.name,
      balance: user.balance,
      currency: user.currency
    })
  );


  loginMessage.textContent =
    "Login successful.";


  setTimeout(function () {

    document.getElementById("loginPage")
      .classList.add("hidden");

    document.getElementById("bankPage")
      .classList.remove("hidden");

    document.getElementById("userName")
      .textContent = user.name;

    document.getElementById("accountNumber")
      .textContent = "•••• " + user.account.slice(-4);

    document.getElementById("balance")
      .textContent =
        new Intl.NumberFormat("en-PH", {
          style: "currency",
          currency: "PHP"
        }).format(user.balance);

  }, 500);

});
```
