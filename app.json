```javascript
let bankData = null;

const account = document.getElementById("account");
const password = document.getElementById("password");
const showPassword = document.getElementById("showPassword");
const loginButton = document.getElementById("loginButton");
const loginMessage = document.getElementById("loginMessage");


// Load bank data
fetch("data.json")
  .then(function(response) {
    if (!response.ok) {
      throw new Error("Could not load data.json");
    }

    return response.json();
  })
  .then(function(data) {
    bankData = data;
  })
  .catch(function() {
    loginMessage.textContent =
      "Unable to connect to bank data.";
  });


// Show / Hide password
showPassword.addEventListener("click", function() {

  if (password.type === "password") {
    password.type = "text";
    showPassword.textContent = "Hide";
  } else {
    password.type = "password";
    showPassword.textContent = "Show";
  }

});


// Sign In
loginButton.addEventListener("click", function() {

  loginMessage.textContent = "";

  if (!bankData) {
    loginMessage.textContent =
      "Bank system is still loading.";
    return;
  }

  const accountNumber = account.value.trim();
  const passwordValue = password.value;

  if (accountNumber === "" || passwordValue === "") {
    loginMessage.textContent =
      "Please enter your account number and password.";
    return;
  }

  const user = bankData.accounts.find(function(item) {
    return (
      item.account === accountNumber &&
      item.password === passwordValue
    );
  });

  if (!user) {
    loginMessage.textContent =
      "Invalid account number or password.";
    return;
  }

  localStorage.setItem(
    "pibUser",
    JSON.stringify({
      account: user.account,
      name: user.name,
      balance: user.balance,
      currency: user.currency
    })
  );

  document.getElementById("loginPage").classList.add("hidden");
  document.getElementById("bankPage").classList.remove("hidden");

  document.getElementById("userName").textContent =
    user.name;

  document.getElementById("accountNumber").textContent =
    "•••• " + user.account.slice(-4);

  document.getElementById("balance").textContent =
    new Intl.NumberFormat("en-PH", {
      style: "currency",
      currency: "PHP"
    }).format(user.balance);

});
```
